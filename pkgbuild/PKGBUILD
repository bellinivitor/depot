pkgname=depot
pkgver=0.1.0
pkgrel=1
pkgdesc='Create local databases in Docker and share them on your tailnet'
arch=('x86_64' 'aarch64')
url='https://github.com/bellinivitor/depot'
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'docker' 'tailscale')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/depot "$pkgdir/usr/bin/depot"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/depot.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/depot.svg"
  install -Dm644 "$startdir/depot.desktop" "$pkgdir/usr/share/applications/depot.desktop"
}
